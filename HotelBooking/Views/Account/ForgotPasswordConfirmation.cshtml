@{
    ViewData["Title"] = "Kiểm tra Email";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow border-0 rounded-4 p-5">
                <i class="bi bi-envelope-check display-1 text-success mb-3"></i>
                <h2 class="fw-bold">Kiểm tra Email của bạn</h2>
                <p class="text-muted mt-3">
                    Nếu email tồn tại trong hệ thống, chúng tôi đã gửi link đặt lại mật khẩu.<br />
                    Vui lòng kiểm tra hộp thư (và cả thư mục Spam).
                </p>
                <p class="small text-muted mt-2">
                    <strong>Demo:</strong> File email được lưu trong thư mục <code>/Emails</code> của project.
                </p>
                <a asp-action="Login" class="btn btn-outline-primary mt-3">Quay lại đăng nhập</a>
            </div>
        </div>
    </div>
</div>