@{
    ViewData["Title"] = "Đặt lại mật khẩu thành công";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow border-0 rounded-4 p-5">
                <i class="bi bi-check-circle display-1 text-success mb-3"></i>
                <h2 class="fw-bold">Thành công!</h2>
                <p class="text-muted mt-3">
                    Mật khẩu của bạn đã được đặt lại thành công.<br />
                    Bây giờ bạn có thể đăng nhập bằng mật khẩu mới.
                </p>
                <a asp-action="Login" class="btn btn-primary mt-3">Đăng nhập ngay</a>
            </div>
        </div>
    </div>
</div>