@model HotelBooking.ViewModels.HotelSearchViewModel
@{
    ViewData["Title"] = "Danh sách khách sạn";
}

<div class="container py-4">
    <h2 class="mb-4 fw-bold">Khách sạn</h2>

    <!-- Search & Filter -->
    <form method="get" class="row g-3 mb-4 p-3 bg-light rounded-3">
        <div class="col-md-4">
            <input type="text" name="Keyword" value="@Model.Keyword" class="form-control" placeholder="Tìm theo tên, địa chỉ..." />
        </div>
        <div class="col-md-3">
            <input type="text" name="City" value="@Model.City" class="form-control" placeholder="Thành phố" />
        </div>
        <div class="col-md-2">
            <select name="Star" class="form-select">
                <option value="">Tất cả sao</option>
                @for (int i = 5; i >= 1; i--)
                {
                    <option value="@i" selected="@(Model.Star == i)">@i sao</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="SortBy" class="form-select">
                <option value="">Mới nhất</option>
                <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Giá tăng dần</option>
                <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Giá giảm dần</option>
                <option value="rating" selected="@(Model.SortBy == "rating")">Đánh giá cao</option>
            </select>
        </div>
        <div class="col-md-1">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search"></i></button>
        </div>
    </form>

    <!-- Hotel cards -->
    <div class="row g-4">
        @if (Model.Hotels.Any())
        {
            @foreach (var h in Model.Hotels)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden">
                        <img src="@(h.Thumbnail ?? "/images/no-image.jpg")" class="card-img-top" style="height:220px;object-fit:cover;" alt="@h.Name" />
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title mb-0">@h.Name</h5>
                                <span class="badge bg-warning text-dark">@h.Star <i class="bi bi-star-fill"></i></span>
                            </div>
                            <p class="text-muted small mb-2">
                                <i class="bi bi-geo-alt"></i> @h.Address, @h.City
                            </p>
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    @if (h.AverageRating > 0)
                                    {
                                        <span class="text-warning">@h.AverageRating.ToString("0.0") <i class="bi bi-star-fill"></i></span>
                                        <small class="text-muted">(@h.ReviewCount)</small>
                                    }
                                </div>
                                <div class="text-end">
                                    @if (h.MinPrice.HasValue)
                                    {
                                        <div class="fw-bold text-primary">@h.MinPrice.Value.ToString("N0") đ</div>
                                        <small class="text-muted">/đêm</small>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-0 pt-0">
                            <a asp-action="Details" asp-route-id="@h.HotelId" class="btn btn-outline-primary w-100">
                                Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-building display-1 text-muted"></i>
                <p class="mt-3 text-muted">Không tìm thấy khách sạn phù hợp.</p>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-Page="@i"
                           asp-route-Keyword="@Model.Keyword"
                           asp-route-City="@Model.City"
                           asp-route-Star="@Model.Star"
                           asp-route-SortBy="@Model.SortBy">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>