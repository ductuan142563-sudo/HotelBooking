<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hotel Booking</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- ========== NAVBAR ========== -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <i class="bi bi-building"></i> HOTEL BOOKING
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Hotels" asp-action="Index">Khách sạn</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Rooms" asp-action="Index">Phòng</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Promotions" asp-action="Index">Khuyến mãi</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Services" asp-action="Index">Dịch vụ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="About">Giới thiệu</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Contact">Liên hệ</a>
                    </li>
                </ul>

                <ul class="navbar-nav">
                    <!-- Guest -->
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Register">
                            <i class="bi bi-person-plus"></i> Đăng ký
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- ========== MAIN CONTENT ========== -->
    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- ========== FOOTER ========== -->
    <footer class="bg-dark text-light py-5 mt-auto">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <h5 class="fw-bold"><i class="bi bi-building"></i> HOTEL BOOKING</h5>
                    <p class="text-muted">Hệ thống đặt phòng khách sạn trực tuyến uy tín, nhanh chóng và tiện lợi.</p>
                </div>
                <div class="col-md-4 mb-4">
                    <h5 class="fw-bold">Liên kết nhanh</h5>
                    <ul class="list-unstyled">
                        <li><a class="text-muted text-decoration-none" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li><a class="text-muted text-decoration-none" asp-controller="Hotels" asp-action="Index">Khách sạn</a></li>
                        <li><a class="text-muted text-decoration-none" asp-controller="Promotions" asp-action="Index">Khuyến mãi</a></li>
                        <li><a class="text-muted text-decoration-none" asp-controller="Home" asp-action="Contact">Liên hệ</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-4">
                    <h5 class="fw-bold">Liên hệ</h5>
                    <p class="text-muted mb-1"><i class="bi bi-geo-alt"></i> 123 Đường ABC, Quận 1, TP.HCM</p>
                    <p class="text-muted mb-1"><i class="bi bi-telephone"></i> 1900 1234</p>
                    <p class="text-muted"><i class="bi bi-envelope"></i> support@hotelbooking.com</p>
                </div>
            </div>
            <hr class="border-secondary">
            <div class="text-center text-muted">
                &copy; @DateTime.Now.Year - Hotel Booking. All rights reserved.
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>