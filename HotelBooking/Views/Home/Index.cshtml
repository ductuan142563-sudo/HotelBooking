@{
    ViewData["Title"] = "Trang chủ";
}

<!-- HERO SECTION -->
<section class="hero-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="text-center mb-5">
                    <h1 class="display-4 fw-bold">Tìm khách sạn hoàn hảo cho kỳ nghỉ của bạn</h1>
                    <p class="lead">Hàng nghìn phòng nghỉ sang trọng đang chờ bạn khám phá</p>
                </div>

                <!-- SEARCH BOX -->
                <div class="search-box">
                    <form asp-controller="Hotels" asp-action="Search" method="get">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label text-dark fw-semibold">Địa điểm</label>
                                <input type="text" name="location" class="form-control form-control-lg" placeholder="Thành phố, khách sạn...">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label text-dark fw-semibold">Nhận phòng</label>
                                <input type="date" name="checkIn" class="form-control form-control-lg" required>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label text-dark fw-semibold">Trả phòng</label>
                                <input type="date" name="checkOut" class="form-control form-control-lg" required>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label text-dark fw-semibold">Số người</label>
                                <select name="guests" class="form-select form-select-lg">
                                    <option value="1">1 người</option>
                                    <option value="2" selected>2 người</option>
                                    <option value="3">3 người</option>
                                    <option value="4">4 người</option>
                                    <option value="5">5+ người</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label text-dark fw-semibold">Số phòng</label>
                                <select name="rooms" class="form-select form-select-lg">
                                    <option value="1" selected>1 phòng</option>
                                    <option value="2">2 phòng</option>
                                    <option value="3">3 phòng</option>
                                    <option value="4">4+ phòng</option>
                                </select>
                            </div>
                            <div class="col-md-1 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary btn-lg w-100">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FEATURED HOTELS (placeholder) -->
<section class="py-5">
    <div class="container">
        <h2 class="text-center mb-5 fw-bold">Khách sạn nổi bật</h2>
        <div class="row g-4">
            <!-- Card 1 -->
            <div class="col-md-4">
                <div class="card hotel-card h-100 shadow-sm">
                    <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80" class="card-img-top" alt="Hotel">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">Grand Luxury Hotel</h5>
                            <span class="badge bg-warning text-dark">5 ★</span>
                        </div>
                        <p class="text-muted small mb-2"><i class="bi bi-geo-alt"></i> Quận 1, TP. Hồ Chí Minh</p>
                        <p class="card-text">Khách sạn 5 sao sang trọng với view sông Sài Gòn tuyệt đẹp.</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-primary">Từ 2.500.000 ₫ / đêm</span>
                            <a href="#" class="btn btn-outline-primary btn-sm">Xem chi tiết</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card 2 -->
            <div class="col-md-4">
                <div class="card hotel-card h-100 shadow-sm">
                    <img src="https://images.unsplash.com/photo-1582719508461-905c673771fd?auto=format&fit=crop&w=800&q=80" class="card-img-top" alt="Hotel">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">Seaside Resort</h5>
                            <span class="badge bg-warning text-dark">4 ★</span>
                        </div>
                        <p class="text-muted small mb-2"><i class="bi bi-geo-alt"></i> Nha Trang, Khánh Hòa</p>
                        <p class="card-text">Resort ven biển với bãi cát trắng và hồ bơi vô cực.</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-primary">Từ 1.800.000 ₫ / đêm</span>
                            <a href="#" class="btn btn-outline-primary btn-sm">Xem chi tiết</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card 3 -->
            <div class="col-md-4">
                <div class="card hotel-card h-100 shadow-sm">
                    <img src="https://images.unsplash.com/photo-1618773928121-c32242e63f39?auto=format&fit=crop&w=800&q=80" class="card-img-top" alt="Hotel">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">Mountain View Hotel</h5>
                            <span class="badge bg-warning text-dark">4 ★</span>
                        </div>
                        <p class="text-muted small mb-2"><i class="bi bi-geo-alt"></i> Đà Lạt, Lâm Đồng</p>
                        <p class="card-text">Không gian yên bình giữa núi rừng, lý tưởng cho nghỉ dưỡng.</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-primary">Từ 1.200.000 ₫ / đêm</span>
                            <a href="#" class="btn btn-outline-primary btn-sm">Xem chi tiết</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>