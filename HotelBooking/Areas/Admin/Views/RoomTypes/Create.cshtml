@model HotelBooking.ViewModels.RoomTypeViewModel
@{
    ViewData["Title"] = "Thêm Loại phòng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <h2 class="mb-4"><i class="bi bi-plus-circle"></i> Thêm Loại phòng mới</h2>

    <div class="card">
        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="MaxGuests" class="form-label"></label>
                        <input asp-for="MaxGuests" class="form-control" type="number" />
                        <span asp-validation-for="MaxGuests" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="BedType" class="form-label"></label>
                        <input asp-for="BedType" class="form-control" placeholder="VD: King, Twin, Queen..." />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Area" class="form-label"></label>
                        <input asp-for="Area" class="form-control" type="number" step="0.1" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="BasePrice" class="form-label"></label>
                        <input asp-for="BasePrice" class="form-control" type="number" step="1000" />
                        <span asp-validation-for="BasePrice" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="ImageFile" class="form-label"></label>
                        <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label d-block">Trạng thái</label>
                        <div class="form-check form-switch mt-2">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label">Đang hoạt động</label>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Lưu
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}