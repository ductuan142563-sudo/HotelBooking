@model HotelBooking.ViewModels.HotelDetailsViewModel
@{
    ViewData["Title"] = Model.Name;
}

<div class="container py-4">
    <!-- Gallery -->
    <div class="row g-2 mb-4">
        <div class="col-md-8">
            <img src="@(Model.Thumbnail ?? "/images/no-image.jpg")" class="img-fluid rounded-4 w-100" style="height:400px;object-fit:cover;" alt="@Model.Name" />
        </div>
        <div class="col-md-4">
            <div class="row g-2">
                @foreach (var img in Model.GalleryImages.Take(4))
                {
                    <div class="col-6">
                        <img src="@img" class="img-fluid rounded-3" style="height:195px;object-fit:cover;width:100%;" />
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <h1 class="fw-bold">@Model.Name</h1>
            <div class="mb-3">
                @for (int i = 1; i <= 5; i++)
                {
                    <i class="bi bi-star@(i <= Model.Star ? "-fill text-warning" : "")"></i>
                }
                <span class="ms-2 text-muted">@Model.Address, @Model.City</span>
            </div>

            <div class="mb-4">
                <h5>Mô tả</h5>
                <p>@(Model.Description ?? "Chưa có mô tả.")</p>
            </div>

            <div class="mb-4">
                <h5>Phòng trống</h5>
                @if (Model.AvailableRooms.Any())
                {
                    <div class="row g-3">
                        @foreach (var room in Model.AvailableRooms)
                        {
                            <div class="col-md-6">
                                <div class="card border-0 shadow-sm">
                                    <div class="card-body">
                                        <h6>@room.RoomTypeName - @room.RoomNumber</h6>
                                        <p class="mb-1 small text-muted">Sức chứa: @room.Capacity người</p>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="fw-bold text-primary">@room.Price.ToString("N0") đ/đêm</span>
                                            <a asp-controller="Rooms" asp-action="Details" asp-route-id="@room.RoomId" class="btn btn-sm btn-outline-primary">Xem phòng</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">Hiện chưa có phòng trống.</p>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-4 sticky-top" style="top:20px;">
                <div class="card-body">
                    <h5 class="mb-3">Thông tin khách sạn</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><i class="bi bi-clock me-2"></i>Nhận phòng: @Model.CheckInTime.ToString(@"hh\:mm")</li>
                        <li class="mb-2"><i class="bi bi-clock-history me-2"></i>Trả phòng: @Model.CheckOutTime.ToString(@"hh\:mm")</li>
                        @if (!string.IsNullOrEmpty(Model.Phone))
                        {
                            <li class="mb-2"><i class="bi bi-telephone me-2"></i>@Model.Phone</li>
                        }
                        @if (!string.IsNullOrEmpty(Model.Email))
                        {
                            <li class="mb-2"><i class="bi bi-envelope me-2"></i>@Model.Email</li>
                        }
                        @if (!string.IsNullOrEmpty(Model.Website))
                        {
                            <li class="mb-2"><i class="bi bi-globe me-2"></i><a href="@Model.Website" target="_blank">Website</a></li>
                        }
                    </ul>

                    @if (Model.AverageRating > 0)
                    {
                        <div class="mt-3 p-3 bg-light rounded-3 text-center">
                            <div class="display-6 fw-bold text-warning">@Model.AverageRating.ToString("0.0")</div>
                            <div class="small text-muted">@Model.ReviewCount đánh giá</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>