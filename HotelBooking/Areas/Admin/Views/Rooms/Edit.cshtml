@model HotelBooking.ViewModels.RoomViewModel
@{
    ViewData["Title"] = "Sửa Phòng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <h2 class="mb-4"><i class="bi bi-pencil-square"></i> Sửa Phòng</h2>

    <div class="card">
        <div class="card-body">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="RoomId" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="HotelId" class="form-label"></label>
                        <select asp-for="HotelId" class="form-select" asp-items="Model.Hotels">
                            <option value="">-- Chọn khách sạn --</option>
                        </select>
                        <span asp-validation-for="HotelId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="RoomTypeId" class="form-label"></label>
                        <select asp-for="RoomTypeId" class="form-select" asp-items="Model.RoomTypes">
                            <option value="">-- Chọn loại phòng --</option>
                        </select>
                        <span asp-validation-for="RoomTypeId" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="RoomNumber" class="form-label"></label>
                        <input asp-for="RoomNumber" class="form-control" />
                        <span asp-validation-for="RoomNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Price" class="form-label"></label>
                        <input asp-for="Price" class="form-control" type="number" step="1000" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Capacity" class="form-label"></label>
                        <input asp-for="Capacity" class="form-control" type="number" />
                        <span asp-validation-for="Capacity" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Floor" class="form-label"></label>
                        <input asp-for="Floor" class="form-control" type="number" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" class="form-select"
                                asp-items="Html.GetEnumSelectList<RoomStatus>()"></select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Ảnh hiện tại</label>
                        @if (!string.IsNullOrEmpty(Model.ExistingImage))
                        {
                            <div class="mb-2">
                                <img src="@Model.ExistingImage" alt="Current"
                                     style="max-width:120px;max-height:80px;object-fit:cover;" class="rounded border" />
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small">Chưa có ảnh</p>
                        }
                        <label asp-for="ImageFile" class="form-label">Upload ảnh mới</label>
                        <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn 