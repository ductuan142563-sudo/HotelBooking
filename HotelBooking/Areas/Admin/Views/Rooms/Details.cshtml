@model HotelBooking.Models.Room
@{
    ViewData["Title"] = "Chi tiết Phòng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-door-open"></i> Chi tiết Phòng @Model.RoomNumber</h2>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.RoomId" class="btn btn-primary me-2">
                <i class="bi bi-pencil"></i> Sửa
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 text-center">
                    @if (!string.IsNullOrEmpty(Model.Image))
                    {
                        <img src="@Model.Image" alt="@Model.RoomNumber"
                             class="img-fluid rounded border" style="max-height:250px;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="bg-light d-flex align-items-center justify-content-center rounded border"
                             style="height:200px;">
                            <span class="text-muted">Không có ảnh</span>
                        </div>
                    }
                </div>
                <div class="col-md-8">
                    <table class="table table-borderless">
                        <tr>
                            <th style="width:180px;">Số phòng</th>
                            <td><strong>@Model.RoomNumber</strong></td>
                        </tr>
                        <tr>
                            <th>Khách sạn</th>
                            <td>@Model.Hotel?.Name</td>
                        </tr>
                        <tr>
                            <th>Loại phòng</th>
                            <td>@Model.RoomType?.Name</td>
                        </tr>
                        <tr>
                            <th>Giá / đêm</th>
                            <td class="text-primary fw-bold">@Model.Price.ToString("N0") ₫</td>
                        </tr>
                        <tr>
                            <th>Sức chứa</th>
                            <td>@Model.Capacity người</td>
                        </tr>
                        <tr>
                            <th>Tầng</th>
                            <td>@(Model.Floor?.ToString() ?? "-")</td>
                        </tr>
                        <tr>
                            <th>Trạng thái</th>
                            <td>
                                @switch (Model.Status)
                                {
                                    case RoomStatus.Available:
                                        <span class="badge bg-success">Available</span>
                                        break;
                                    case RoomStatus.Occupied:
                                        <span class="badge bg-warning text-dark">Occupied</span>
                                        break;
                                    case RoomStatus.Maintenance:
                                        <span class="badge 